# Network: `mainnet` (default, chainId 5042) or `testnet` (chainId 5042002).
NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.arc-scan.org

# PayoutDistributor per network — the app reads the one matching NEXT_PUBLIC_ARC_NETWORK
NEXT_PUBLIC_PAYOUT_DISTRIBUTOR=
NEXT_PUBLIC_PAYOUT_DISTRIBUTOR_MAINNET=0x5c3dace0e3555775f2a1b5396280805b9d114be6

# contracts/ deployment (forge script script/Deploy.s.sol:Deploy)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_MAINNET_RPC_URL=https://rpc.arc-scan.org
PAYOUT_ADMIN=
PAYOUT_TREASURY=

# Server-only. Wallet that pays Arc gas to submit CCTP `receiveMessage` for users (auto-mint relayer).
# Leave empty to make users mint from their own wallet.
CCTP_RELAYER_KEY=
